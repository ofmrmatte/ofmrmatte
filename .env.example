# Server only. Copy to .env locally; use Railway service Variables in production.
APP_AUTH_ENABLED=1
XTREAM_URL=https://your-provider.example
XTREAM_USERNAME=
XTREAM_PASSWORD=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Convite opcional: cadastros sem código são permitidos; códigos informados são validados.
REGISTRATION_CODE=
# Token secreto para criar o Master Admin uma única vez.
ADMIN_SETUP_TOKEN=
# PostgreSQL on Railway: ${{Postgres.DATABASE_URL}}
# Without DATABASE_URL, use SQLite on a persistent volume.
DATABASE_URL=
APP_DATA_DIR=.data
PARENTAL_DATA_DIR=.data
# Daily public trends work without a key. Set 0 to disable external discovery.
DISCOVERY_ENABLED=1
# Optional private TMDB API Read Access Token; never use a browser/public variable.
TMDB_API_READ_ACCESS_TOKEN=
# Optional absolute path to an official ClassInd CSV export (server only).
CLASSIND_CSV_FILE=
